---
import { LOJAS } from '../data/site';
import { linkAfiliado, REL_AFILIADO } from '../lib/links';
import { brl, dataCurta, isoDia, pctOff } from '../lib/format';
const { oferta, eager = false } = Astro.props;
const loja = LOJAS[oferta.loja as keyof typeof LOJAS];
---
<li>
  <article class="card">
    {oferta.imagem && (
      <a class="thumb" href={linkAfiliado(oferta.url, oferta.loja)} rel={REL_AFILIADO} target="_blank" tabindex="-1" aria-hidden="true">
        <img src={oferta.imagem} alt={oferta.titulo} width="400" height="400" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" />
      </a>
    )}
    <span class="tag" style={`background:${loja.cor}`}>{loja.nome}</span>
    <h3>{oferta.titulo}</h3>
    <p class="preco">
      {oferta.precoAnterior && <s>{brl(oferta.precoAnterior)}</s>}
      {brl(oferta.precoAtual)}
      {oferta.precoAnterior && <span class="off">−{pctOff(oferta.precoAtual, oferta.precoAnterior)}%</span>}
    </p>
    {oferta.observacao && <p class="meta">{oferta.observacao}</p>}
    <p class="meta">Preço visto em {dataCurta(isoDia(oferta.verificadoEm))}. Pode mudar sem aviso.</p>
    <a class="btn" href={linkAfiliado(oferta.url, oferta.loja)} rel={REL_AFILIADO} target="_blank">Ver na {loja.nome}</a>
  </article>
</li>
