        <path d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zM17.4 6.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 4.4c1.3 0 1.5 0 2 .1.5 0 .8.1 1.1.2.3.1.6.3.8.5.2.2.4.5.5.8.1.3.2.6.2 1.1.1.5.1.7.1 2s0 1.5-.1 2c0 .5-.1.8-.2 1.1-.1.3-.3.6-.5.8-.2.2-.5.4-.8.5-.3.1-.6.2-1.1.2-.5.1-.7.1-2 .1s-1.5 0-2-.1c-.5 0-.8-.1-1.1-.2-.3-.1-.6-.3-.8-.5-.2-.2-.4-.5-.5-.8-.1-.3-.2-.6-.2-1.1-.1-.5-.1-.7-.1-2s0-1.5.1-2c0-.5.1-.8.2-1.1.1-.3.3-.6.5-.8.2-.2.5-.4.8-.5.3-.1.6-.2 1.1-.2.5-.1.7-.1 2-.1zm0-1.6c-1.3 0-1.6 0-2.1.1-.6 0-1 .1-1.3.3-.4.1-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.2.7-.3 1.3-.1.5-.1.8-.1 2.1s0 1.6.1 2.1c0 .6.1 1 .3 1.3.1.4.4.7.7 1 .3.3.6.5 1 .7.3.1.7.2 1.3.3.5.1.8.1 2.1.1s1.6 0 2.1-.1c.6 0 1-.1 1.3-.3.4-.1.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.2-.7.3-1.3.1-.5.1-.8.1-2.1s0-1.6-.1-2.1c0-.6-.1-1-.3-1.3-.1-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.7-.2-1.3-.3-.5-.1-.8-.1-2.1-.1z" />
      </svg>
    </div>
    <div class="zap-texto">
      <h2 id="ig-titulo">Acompanhe a curadoria no Instagram</h2>
      <p>Siga @achadinhos.cupons.blog para ver os cupons e as ofertas que conferimos.</p>
    </div>
    <a class="btn" href={SITE.instagram} target="_blank" rel="noopener noreferrer">
      Seguir no Instagram
    </a>
  </aside>
</div>
